# Copy this file to ".env" and tweak as needed.

# Port the Express app listens on
PORT=3000

# MongoDB connection URI.  Leave UNSET to use the bundled
# mongodb-memory-server fallback (no external MongoDB required).
# MONGODB_URI=mongodb://127.0.0.1:27017/sparc

# Used by the dummy mailer below — these are never actually sent anywhere.
DUMMY_MAIL_TO=sparc.ideas@gmail.com
DUMMY_MAIL_FROM=SpArc Enquiry <sparc@root-kings.com>
